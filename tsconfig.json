{
    "compilerOptions": {
        "outDir": "dist",
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "jsx": "react",
        "allowJs": true,
        "paths": {
            "@*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src"
    ]
}